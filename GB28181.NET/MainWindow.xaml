<Window
    x:Class="GB28181.NET.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GB28181.NET"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:GB28181.NET.ViewModels"
    Title="MainWindow"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    Style="{StaticResource MaterialDesignWindow}"
    WindowState="Maximized"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="10*" />
        </Grid.ColumnDefinitions>
        <StackPanel
            x:Name="LeftRail"
            Grid.Column="0"
            Width="55"
            HorizontalAlignment="Left"
            Background="{DynamicResource MaterialDesignCardBackground}">
            <ToggleButton
                Width="27"
                Margin="0,32,0,0"
                Checked="ToggleButton_Checked"
                Style="{StaticResource MaterialDesignHamburgerToggleButton}"
                Unchecked="ToggleButton_Unchecked" />
            <Button
                Grid.Row="1"
                Width="56"
                Height="56"
                Margin="0,10,0,0"
                materialDesign:ButtonAssist.CornerRadius="16"
                Background="{DynamicResource SecondaryHueMidBrush}"
                BorderThickness="0"
                Click="Button_Click"
                Foreground="{DynamicResource SecondaryHueMidBrushForeground}"
                Style="{StaticResource MaterialDesignFlatMidBgButton}"
                Tag="Home">
                <materialDesign:PackIcon
                    Width="24"
                    Height="24"
                    Kind="Home" />
            </Button>
            <Button
                Grid.Row="2"
                Width="56"
                Height="56"
                Margin="0,10,0,0"
                materialDesign:ButtonAssist.CornerRadius="16"
                Background="{DynamicResource SecondaryHueMidBrush}"
                BorderThickness="0"
                Click="Button_Click"
                Foreground="{DynamicResource SecondaryHueMidBrushForeground}"
                Style="{StaticResource MaterialDesignFlatMidBgButton}"
                Tag="Setting"
                ToolTip="基础配置">
                <materialDesign:PackIcon
                    Width="24"
                    Height="24"
                    Kind="Cog" />
            </Button>
            <Button
                Grid.Row="2"
                Width="56"
                Height="56"
                Margin="0,10,0,0"
                materialDesign:ButtonAssist.CornerRadius="16"
                Background="{DynamicResource SecondaryHueMidBrush}"
                BorderThickness="0"
                Click="Button_Click"
                Foreground="{DynamicResource SecondaryHueMidBrushForeground}"
                Style="{StaticResource MaterialDesignFlatMidBgButton}"
                Tag="Device"
                ToolTip="设备列表">
                <materialDesign:PackIcon
                    Width="24"
                    Height="24"
                    Kind="CameraIris" />
            </Button>
        </StackPanel>

        <!--  主页面  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Frame x:Name="FrameWork" NavigationUIVisibility="Hidden" />

        </Grid>
    </Grid>
</Window>
