<Window
    x:Class="GB28181.NET.Views.Dialogs.AddDeviceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GB28181.NET.Views.Dialogs"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AddDeviceDialog"
    Width="800"
    Height="450"
    Background="#1A1A1A"
    mc:Ignorable="d">
    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <StackPanel Margin="0,0,0,40" Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="15"
                    Text="用户名：" />
                <TextBox
                    Width="150"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Margin="0,0,0,40" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="15"
                    Text="设备IP：" />
                <TextBox
                    Width="150"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Margin="0,0,0,40" Orientation="Horizontal">
                <TextBlock
                    Margin="-12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="15"
                    Text="设备端口：" />
                <TextBox
                    Width="150"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
