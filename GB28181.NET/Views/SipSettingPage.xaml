<Page
    x:Class="GB28181.NET.Views.SipSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GB28181.NET.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:GB28181.NET.ViewModels"
    Title="SipSettingPage"
    d:DataContext="{d:DesignInstance Type=vm:SipSettingPageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="#ECECEC"
    mc:Ignorable="d">
    <Grid Margin="0,30,0,0">
        <ScrollViewer
            materialDesign:ScrollViewerAssist.IsAutoHideEnabled="True"
            materialDesign:ScrollViewerAssist.ShowSeparators="True"
            VerticalScrollBarVisibility="Hidden">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                    <TextBlock
                        Margin="0,0,0,30"
                        FontSize="15"
                        FontWeight="Thin"
                        Text="信令服务配置：" />
                    <StackPanel Margin="15,0,0,40" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="14"
                            Text="SIP ID" />
                        <TextBox
                            Width="auto"
                            MinWidth="160"
                            Margin="30,0,0,0"
                            Padding="7,0,0,0"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.HelperText="SIP服务唯一标识"
                            materialDesign:HintAssist.IsFloating="True"
                            FontSize="14"
                            Text="{Binding SipSetting.Id}" />
                    </StackPanel>
                    <StackPanel Margin="15,0,0,40" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="14"
                            Text="SIP 域" />
                        <TextBox
                            Width="160"
                            Margin="30,0,0,0"
                            Padding="7,0,0,0"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.HelperText="SIP服务所属域"
                            materialDesign:HintAssist.IsFloating="True"
                            FontSize="14"
                            Text="{Binding SipSetting.Realm}" />
                    </StackPanel>
                    <StackPanel Margin="15,0,0,40" Orientation="Horizontal">
                        <TextBlock
                            Margin="-13,5,0,0"
                            FontSize="14"
                            Text="SIP Host" />
                        <TextBox
                            Width="160"
                            Margin="30,0,0,0"
                            Padding="7,0,0,0"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.HelperText="SIP服务主机地址"
                            materialDesign:HintAssist.IsFloating="True"
                            FontSize="14"
                            Text="{Binding SipSetting.Host}" />
                    </StackPanel>
                    <StackPanel Margin="15,0,0,40" Orientation="Horizontal">
                        <TextBlock
                            Margin="-12,5,0,0"
                            FontSize="14"
                            Text="SIP 端口" />
                        <TextBox
                            Width="160"
                            Margin="30,0,0,0"
                            Padding="7,0,0,0"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.HelperText="SIP服务端口"
                            materialDesign:HintAssist.IsFloating="True"
                            FontSize="14"
                            Text="{Binding SipSetting.Port}" />
                    </StackPanel>
                    <StackPanel Margin="15,0,0,40" Orientation="Horizontal">
                        <TextBlock
                            Margin="-40,5,0,0"
                            FontSize="14"
                            Text="设备接入密码" />
                        <TextBox
                            Width="160"
                            Margin="30,0,0,0"
                            Padding="7,0,0,0"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.HelperText="接入设备需要验证的密码"
                            materialDesign:HintAssist.IsFloating="True"
                            FontSize="14"
                            Text="{Binding SipSetting.Password}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Margin="30,0,0,0"
                    Orientation="Vertical">
                    <TextBlock
                        Margin="0,0,0,30"
                        FontSize="15"
                        FontWeight="Thin"
                        Text="流媒体服务配置：" />
                    <StackPanel Margin="15,0,0,40" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="14"
                            Text="服务地址" />
                        <TextBox
                            Width="160"
                            Margin="30,0,0,0"
                            Padding="7,0,0,0"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.HelperText="流媒体服务地址"
                            materialDesign:HintAssist.IsFloating="True"
                            FontSize="14"
                            Text="{Binding MediaSetting.Host}" />
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="1" Grid.ColumnSpan="2">
                    <Button
                        Width="auto"
                        MaxWidth="200"
                        HorizontalAlignment="Center"
                        Command="{Binding SaveBasicSettingCommand}"
                        Content="保存" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
