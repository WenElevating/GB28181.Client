<Page
    x:Class="GB28181.NET.Views.DeviceListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GB28181.NET.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:GB28181.NET.ViewModels"
    Title="DeviceListPage"
    d:DataContext="{d:DesignInstance Type=vm:DeviceListPageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="0,35,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="50" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock
            Margin="0,0,0,0"
            VerticalAlignment="Center"
            FontSize="16"
            FontWeight="Bold"
            Text="设备列表：" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <materialDesign:PackIcon
                    VerticalAlignment="Center"
                    Foreground="White"
                    Kind="AccountSearch" />
                <TextBox
                    Width="200"
                    Height="30"
                    Margin="15,0,0,0"
                    Padding="10,0,0,0"
                    materialDesign:HintAssist.HelperTextFontSize="9"
                    materialDesign:HintAssist.Hint="根据用户名查找"
                    Style="{StaticResource MaterialDesignFilledTextBox}"
                    Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Margin="0,0,20,0"
                HorizontalAlignment="Right">
                <Button Width="120" Content="新增设备" />
            </StackPanel>
        </Grid>
        <DataGrid
            Grid.Row="2"
            VerticalContentAlignment="Center"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            HeadersVisibility="All"
            IsReadOnly="True"
            ItemsSource="{Binding DeviceView}"
            SelectionMode="Extended"
            SelectionUnit="Cell"
            VirtualizingPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding Username}"
                    Header="用户名" />
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding Password}"
                    Header="密码" />
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding HomeIp}"
                    Header="主机地址" />
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding HomePort}"
                    Header="主机端口" />
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding Expiry}"
                    Header="有效期" />
                <DataGridTemplateColumn Width="200" Header="操作">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="修改" />
                                <Button Margin="10,0,0,0" Content="删除" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
